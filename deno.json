{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno desktop --hmr --permission-set=app main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "typecheck": "deno check --desktop main.ts",
    "test": "deno test --permit-no-files --permission-set=app",
    "check": "deno fmt --check && deno lint && deno check --desktop main.ts && deno test --permit-no-files --permission-set=app",
    "build:linux": "deno desktop --permission-set=app --target x86_64-unknown-linux-gnu --output dist/linux/DSH-Desktop main.ts",
    "build:windows": "deno desktop --permission-set=app --target x86_64-pc-windows-msvc --output dist/windows/DSH-Desktop main.ts",
    "build:macos:aarch64": "deno desktop --permission-set=app --target aarch64-apple-darwin --output dist/macos/aarch64/DSH-Desktop.app main.ts",
    "build:macos:x86_64": "deno desktop --permission-set=app --target x86_64-apple-darwin --output dist/macos/x86_64/DSH-Desktop.app main.ts",
    "package:linux": "deno desktop --permission-set=app --target x86_64-unknown-linux-gnu --output dist/linux/DSH-Desktop.AppImage main.ts",
    "package:windows": "deno desktop --permission-set=app --target x86_64-pc-windows-msvc --output dist/windows/DSH-Desktop.msi main.ts",
    "package:macos:aarch64": "deno desktop --permission-set=app --target aarch64-apple-darwin --output dist/macos/DSH-Desktop-aarch64.dmg main.ts",
    "package:macos:x86_64": "deno desktop --permission-set=app --target x86_64-apple-darwin --output dist/macos/DSH-Desktop-x86_64.dmg main.ts"
  },
  "permissions": {
    "app": {
      "env": true,
      "read": true,
      "write": true,
      "run": true,
      "net": [
        "127.0.0.1",
        "[::1]"
      ]
    }
  },
  "desktop": {
    "app": {
      "name": "DSH Desktop",
      "identifier": "ai.deepseek.dsh.desktop"
    },
    "backend": "cef",
    "output": {
      "macos": "./dist/macos/DSH-Desktop.app",
      "windows": "./dist/windows/DSH-Desktop",
      "linux": "./dist/linux/DSH-Desktop"
    }
  },
  "exclude": [
    "dist/"
  ],
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
